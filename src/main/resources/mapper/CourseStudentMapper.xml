<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.score.studentscoresystem.mapper.CourseStudentMapper">
    
    <insert id="insert">
        INSERT INTO course_student (course_id, student_id)
        VALUES (#{courseId}, #{studentId})
    </insert>
    
    <delete id="deleteByCourseAndStudent">
        DELETE FROM course_student 
        WHERE course_id = #{courseId} AND student_id = #{studentId}
    </delete>
    
    <select id="selectByCourseId" resultType="CourseStudent">
        SELECT * FROM course_student WHERE course_id = #{courseId}
    </select>
    
    <select id="selectByStudentId" resultType="CourseStudent">
        SELECT * FROM course_student WHERE student_id = #{studentId}
    </select>
    
</mapper>
